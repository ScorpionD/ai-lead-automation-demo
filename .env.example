# No frontend secrets or VITE_* values are needed.
# Local Vite defaults to local preview. Live calls use /api/leads.
# Set these values only in the dedicated n8n server's private .env (chmod 600).
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
LEAD_WEBHOOK_SECRET=
TUNNEL_TOKEN=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
# Keep disabled until API credits and cost authorization are available.
OPENAI_ENABLED=false

# Cloudflare Worker secrets (Wrangler secret bulk or dashboard):
# LEAD_WEBHOOK_SECRET must match n8n.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# The site key is public. The secret key stays on the Worker.

# Deployment tooling only; never copy into the browser build:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
N8N_API_KEY=

# Email is not implemented until a test sender and recipient are configured.
