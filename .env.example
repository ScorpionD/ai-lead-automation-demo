# No frontend secrets or VITE_* values are needed.
# Local Vite defaults to local preview. Live calls use /api/leads.
# Set these values only in the dedicated n8n server's private .env (chmod 600).
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
LEAD_WEBHOOK_SECRET=
TUNNEL_TOKEN=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
# Deployed OpenRouter key: encrypted n8n HTTP Header Auth credential
# "OpenRouter lead qualification", Authorization: Bearer YOUR_KEY.
# Alternative: private server env + an n8n header expression that reads it.
OPENROUTER_API_KEY=

# Non-secret Cloudflare Worker environment variables (worker/wrangler.jsonc):
# These are not frontend VITE_* variables and are not read from a local Vite .env.
AI_PROVIDER=openrouter
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
# openrouter/free is also supported; paid model IDs are rejected.
OPENAI_MODEL=gpt-4.1-mini
ALLOW_PAID_AI=false
# OPENAI_ENABLED is obsolete. OpenAI requires AI_PROVIDER=openai plus
# ALLOW_PAID_AI=true and separate authorization for costs; it is currently off.

# Cloudflare Worker secrets (Wrangler secret bulk or dashboard):
# LEAD_WEBHOOK_SECRET must match n8n.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# The site key is public. The secret key stays on the Worker.

# Deployment tooling only; never copy into the browser build:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
N8N_API_KEY=

# Email is not implemented until a test sender and recipient are configured.
